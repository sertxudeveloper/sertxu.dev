<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Landlord">
            <directory>tests/Landlord</directory>
            <directory>modules/*/Tests/Landlord</directory>
        </testsuite>
        <testsuite name="Tenant">
            <directory>tests/Tenant</directory>
            <directory>modules/*/Tests/Tenant</directory>
        </testsuite>
        <!--<testsuite name="Arch">
            <file>tests/ArchTest.php</file>
            <directory>tests/Arch</directory>
        </testsuite>-->
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
            <directory>config</directory>
            <directory>routes</directory>
            <directory>modules</directory>
        </include>
        <exclude>
            <directory>modules/*/Database</directory>
            <directory>modules/*/Lang</directory>
            <directory>modules/*/Tests</directory>
            <directory>modules/*/Views</directory>
        </exclude>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_KEY" value="base64:YENY6eTFuCfz5wAVebIdqkHkmQblMWvJogqJ4ymTwLw="/>
        <env name="APP_URL" value="http://tenancy.test"/>
        <env name="LOG_STACK" value="single"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="database"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="FILESYSTEM_DISK" value="landlord"/>
        <env name="FILESYSTEM_TENANT_DISK" value="tenant"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="database"/>
        <env name="SESSION_DRIVER" value="database"/>
        <env name="SESSION_DOMAIN" value=".tenancy.test"/>
        <env name="TELESCOPE_ENABLED" value="false"/>

        <env name="DB_CONNECTION" value="landlord"/>
        <env name="DB_TENANT_CONNECTION" value="tenant"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="5432"/>
        <env name="DB_DATABASE" value="landlord_test"/>
        <env name="DB_USERNAME" value="postgres"/>
        <env name="DB_PASSWORD" value="postgres"/>
        <env name="DB_CACHE_CONNECTION" value="landlord"/>
        <env name="DB_QUEUE_CONNECTION" value="landlord"/>
        <env name="SESSION_CONNECTION" value="landlord"/>
        <env name="PULSE_DB_CONNECTION" value="landlord"/>

        <env name="AWS_ENDPOINT" value="https://s3.example.com"/>
        <env name="AWS_ACCESS_KEY_ID" value=""/>
        <env name="AWS_SECRET_ACCESS_KEY" value=""/>
        <env name="AWS_DEFAULT_REGION" value="garage"/>
        <env name="AWS_BUCKET" value="testing-landlord"/>
        <env name="AWS_USE_PATH_STYLE_ENDPOINT" value="false"/>
        <env name="AWS_ROOT_DOMAIN" value=".cdn.example.com"/>
        <env name="AWS_URL" value="https://testing-landlord.cdn.example.com"/>
    </php>
</phpunit>
