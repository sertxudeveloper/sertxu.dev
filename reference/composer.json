{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "grupoperis/intranet",
    "type": "project",
    "description": "Intranet - Transpack Group",
    "keywords": [
        "grupoperis",
        "transpackgroup",
        "intranet"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "ext-dom": "*",
        "ext-intl": "*",
        "directorytree/imapengine-laravel": "^1.1",
        "filament/filament": "^5.0",
        "filament/spatie-laravel-settings-plugin": "^5.0",
        "laravel-lang/lang": "^15.19",
        "laravel/framework": "^13.0",
        "laravel/nightwatch": "^1.9",
        "laravel/pennant": "^1.16",
        "laravel/pulse": "^1.4",
        "laravel/reverb": "^1.0",
        "laravel/tinker": "^3.0.0",
        "league/flysystem-aws-s3-v3": "^3.31",
        "livewire/blaze": "^1.0",
        "livewire/flux": "^2.9",
        "livewire/flux-pro": "^2.9",
        "livewire/livewire": "^4.0",
        "milon/barcode": "^13.1",
        "phiki/phiki": "^2.0",
        "pontedilana/php-weasyprint": "^2.4",
        "sentry/sentry-laravel": "^4.15",
        "sertxudeveloper/laravel-counters": "^2.0",
        "spatie/laravel-data": "^4.17",
        "spatie/laravel-medialibrary": "^11.12",
        "spatie/laravel-multitenancy": "^4.0.4",
        "spatie/laravel-pdf": "^2.1",
        "spatie/laravel-ray": "^1.43",
        "spatie/laravel-settings": "^3.4",
        "spatie/pdf-to-text": "^1.54",
        "spatie/temporary-directory": "^2.3",
        "ueberdosis/tiptap-php": "^2.0",
        "webklex/laravel-pdfmerger": "^1.3"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.0",
        "barryvdh/laravel-translation-manager": "^0.6.8",
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.2",
        "laravel/boost": "^2.0",
        "laravel/pail": "^1.2.2",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.18",
        "laravel/sail": "^1.41",
        "sertxudeveloper/laravel-translations-checker": "^1.0",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "pestphp/pest-plugin-livewire": "^5.0",
        "pestphp/pest-plugin-type-coverage": "^5.0",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Modules\\": "modules/"
        },
        "files": [
            "resources/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Tests\\Database\\Seeders\\": "tests/database/seeders/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force --database landlord --path database/migrations/landlord --seed",
            "@php artisan tenants:artisan \"migrate --force --seed\"",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "lint": [
            "pint --parallel"
        ],
        "refactor": [
            "rector"
        ],
        "test:lint": [
            "pint --parallel --test"
        ],
        "test:refactor": [
            "rector --dry-run"
        ],
        "test:types": [
            "phpstan analyse"
        ],
        "test:arch": [
            "pest --filter=arch"
        ],
        "test:type-coverage": [
            "pest --type-coverage --compact --min=100 --ci"
        ],
        "test:tia-baseline": [
            "pest --parallel --tia --coverage --fresh"
        ],
        "test:unit-tia": [
            "pest --parallel --coverage --compact --min=100 --tia --filtered"
        ],
        "test:unit": [
            "pest --parallel --coverage --compact --min=100 --ci"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan boost:update"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "process-timeout": 600,
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": {
        "flux-pro": {
            "type": "composer",
            "url": "https://composer.fluxui.dev"
        }
    }
}
